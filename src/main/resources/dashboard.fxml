<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.khushi.passwordcracker.PasswordCrackerGUI$Controller"
            styleClass="root-pane">

    <!-- ================= HEADER ================= -->

    <top>
        <VBox alignment="CENTER"
              spacing="5"
              styleClass="header-panel">

            <padding>
                <Insets top="18" right="20" bottom="16" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                <Button text="←  Dashboard"
                        onAction="#handleBack"
                        styleClass="terminal-button-secondary"/>
            </HBox>

            <Label text="🔐  Password Cracker Toolkit"
                   styleClass="title-label"/>

            <Label text="Educational Password Security Simulator"
                   styleClass="subtitle-label"/>

            <Label text="SHA-256  •  Multiple Attack Strategies  •  JavaFX"
                   styleClass="tech-label"/>

        </VBox>
    </top>


    <!-- ================= MAIN DASHBOARD ================= -->

    <center>

        <GridPane hgap="16"
                  vgap="16"
                  styleClass="main-grid">

            <padding>
                <Insets top="18" right="20" bottom="12" left="20"/>
            </padding>

            <columnConstraints>

                <ColumnConstraints percentWidth="50"
                                   hgrow="ALWAYS"/>

                <ColumnConstraints percentWidth="50"
                                   hgrow="ALWAYS"/>

            </columnConstraints>


            <!-- =================================================
                 LEFT SIDE - ATTACK CONFIGURATION
                 ================================================= -->

            <VBox GridPane.columnIndex="0"
                  spacing="14"
                  styleClass="card">

                <Label text="⚔  ATTACK CONFIGURATION"
                       styleClass="section-title"/>

                <Label text="Configure the attack parameters below."
                       styleClass="section-subtitle"/>


                <!-- Target Hash -->

                <VBox spacing="6">

                    <Label text="Target Hash"
                           styleClass="field-label"/>

                    <TextField fx:id="targetHashField"
                               promptText="Enter SHA-256 hash"
                               styleClass="terminal-field"/>

                </VBox>


                <!-- Attack Type -->

                <VBox spacing="6">

                    <Label text="Attack Type"
                           styleClass="field-label"/>

                    <ComboBox fx:id="algorithmBox"
                              prefWidth="300"
                              maxWidth="Infinity"
                              promptText="Select Algorithm"
                              styleClass="terminal-field"/>

                </VBox>


                <!-- Maximum Length -->

                <VBox spacing="6">

                    <Label text="Maximum Length"
                           styleClass="field-label"/>

                    <TextField fx:id="maxLengthField"
                               promptText="Maximum password length"
                               styleClass="terminal-field"/>

                </VBox>


                <!-- Mask -->

                <VBox spacing="6">

                    <Label text="Mask Pattern"
                           styleClass="field-label"/>

                    <TextField fx:id="maskField"
                               promptText="Example: ?l?l?l"
                               styleClass="terminal-field"/>

                </VBox>


                <!-- Start / Stop / Clear Buttons -->

                <Button fx:id="startButton"
                        text="🚀  START ATTACK"
                        onAction="#handleStartAttack"
                        maxWidth="Infinity"
                        styleClass="terminal-button-primary"/>

                <HBox spacing="10">

                    <Button fx:id="stopButton"
                            text="⏹  STOP"
                            onAction="#handleStopAttack"
                            disable="true"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="terminal-button-secondary"/>

                    <Button fx:id="clearButton"
                            text="🧹  CLEAR"
                            onAction="#handleClear"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"
                            styleClass="terminal-button-secondary"/>

                </HBox>

            </VBox>


            <!-- =================================================
                 RIGHT SIDE - ATTACK SUMMARY
                 ================================================= -->

            <VBox GridPane.columnIndex="1"
                  spacing="14"
                  styleClass="card">

                <Label text="📊  ATTACK SUMMARY"
                       styleClass="section-title"/>

                <Label text="Real-time result information."
                       styleClass="section-subtitle"/>


                <!-- Status -->

                <VBox spacing="5"
                      styleClass="result-card">

                    <Label text="STATUS"
                           styleClass="result-title"/>

                    <Label fx:id="statusLabel"
                           text="Idle"
                           styleClass="status-idle"/>

                </VBox>


                <!-- Attempts -->

                <VBox spacing="5"
                      styleClass="result-card">

                    <Label text="ATTEMPTS"
                           styleClass="result-title"/>

                    <Label fx:id="attemptsLabel"
                           text="Attempts : 0"
                           styleClass="result-value"/>

                </VBox>


                <!-- Execution Time -->

                <VBox spacing="5"
                      styleClass="result-card">

                    <Label text="EXECUTION TIME"
                           styleClass="result-title"/>

                    <Label fx:id="executionTimeLabel"
                           text="Execution Time : 0 ms"
                           styleClass="result-value"/>

                </VBox>


                <!-- Password -->

                <VBox spacing="5"
                      styleClass="result-card">

                    <Label text="PASSWORD RESULT"
                           styleClass="result-title"/>

                    <Label fx:id="passwordLabel"
                           text="Password : Not Found"
                           wrapText="true"
                           styleClass="result-value"/>

                </VBox>

                <!-- Techniques Used -->

<VBox spacing="5"
      styleClass="result-card">

   <Label text="TECHNIQUES USED"
       styleClass="result-title"/>

<Label fx:id="techniquesLabel"
       text="—"
       wrapText="true"
       styleClass="result-value"/>

</VBox>


                <!-- Progress -->

                <VBox spacing="7">

                    <Label text="ATTACK PROGRESS"
                           styleClass="field-label"/>

                    <ProgressBar fx:id="progressBar"
                                 progress="0.0"
                                 maxWidth="Infinity"/>

                </VBox>

            </VBox>

        </GridPane>

    </center>


    <!-- ================= LIVE CONSOLE ================= -->

    <bottom>

        <VBox spacing="8"
              styleClass="card">

            <padding>
                <Insets top="8" right="20" bottom="18" left="20"/>
            </padding>

            <HBox alignment="CENTER_LEFT">

                <Label text="💻  LIVE ATTACK CONSOLE"
                       styleClass="section-title"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Label text="SYSTEM OUTPUT"
                       styleClass="tech-label"/>

            </HBox>


            <TextArea fx:id="outputArea"
                      editable="false"
                      wrapText="true"
                      prefRowCount="4"
                      maxWidth="Infinity"
                      text="No attack run yet."
                      styleClass="console"/>

        </VBox>

    </bottom>

</BorderPane>