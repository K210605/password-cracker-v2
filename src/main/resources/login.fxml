<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.khushi.passwordcracker.LoginController"
            styleClass="root-pane">

    <center>
        <VBox alignment="CENTER"
              spacing="16"
              maxWidth="380"
              styleClass="card">

            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Label text="🔐  Password Cracker Toolkit"
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="title-label"/>

            <Label text="Authorized Access Only  •  Research &amp; Education"
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="subtitle-label"/>

            <VBox spacing="6">
                <Label text="Username" styleClass="field-label"/>
                <TextField fx:id="usernameField"
                           promptText="Enter username"
                           styleClass="terminal-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter password"
                               styleClass="terminal-field"/>
            </VBox>

            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true"
                   styleClass="status-fail"/>

            <Button fx:id="loginButton"
                    text="🔓  LOGIN"
                    onAction="#handleLogin"
                    maxWidth="Infinity"
                    styleClass="terminal-button-primary"/>

            <Label text="Demo credentials — admin / password123"
                   styleClass="section-subtitle"/>

        </VBox>
    </center>

</BorderPane>
